---
// Product mode: every dark / verify surface. Navy ground, phosphor for the
// chain, orange for the human, red for refusal only. Tokens from design/tokens.json.
import tokens from '../../../design/tokens.json';

interface Props {
  title: string;
  right?: string;
  brand?: string;
}
const { title, right = '', brand = 'timmy-tui · custody lane' } = Astro.props;
const c = tokens.modes.product.color;
const f = tokens.modes.product.font;
const vars = [
  `--navy:${c.navy.value}`,
  `--navy-2:${c['navy-2'].value}`,
  `--navy-line:${c['navy-line'].value}`,
  `--phosphor:${c.phosphor.value}`,
  `--phosphor-dim:${c['phosphor-dim'].value}`,
  `--orange:${c.orange.value}`,
  `--red:${c.red.value}`,
  `--text:${c.text.value}`,
  `--text-2:${c['text-2'].value}`,
  `--text-muted:${c['text-muted'].value}`,
  `--font-human:${f.human.family}`,
  `--font-chain:${f.chain.family}`
].join(';');
---

<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>{title} · Vault Custody</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href={f.googleFonts} rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <span class="brand">{brand}</span>
      <span class="right">{right}</span>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { background: var(--navy); }
  body { margin: 0; background: var(--navy); color: var(--text); font-family: var(--font-chain); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 40px 48px 16px; }
  .brand { font-weight: 700; font-size: 1.15em; color: var(--text); }
  .right { color: var(--text-2); font-size: 0.9em; }
  main { padding: 0 48px 64px; }
  .human { font-family: var(--font-human); }
  .chain { color: var(--phosphor); }
  .chain-dim { color: var(--phosphor-dim); }
  .who { color: var(--orange); }
  .refuse { color: var(--red); }
  .muted { color: var(--text-muted); }
  .pill { display: inline-block; border: 1px solid var(--navy-line); background: var(--navy-2); border-radius: 4px; padding: 0.15em 0.7em; color: var(--text-2); font-size: 0.85em; margin-left: 1em; }
  .line { margin: 0; padding: 0.35em 0; white-space: pre-wrap; word-break: break-word; }
  .line .seq { color: var(--text-muted); margin-right: 1.5em; }
  .line .kind { color: var(--phosphor); margin-right: 1.5em; }
  .line.tamper .kind { color: var(--orange); }
  .line .hash { color: var(--phosphor-dim); }
  .line .via { color: var(--orange); }
  .line .ts { color: var(--text-2); }
  .rule { border: 0; border-top: 1px solid var(--navy-line); margin: 2em 0; }
  h1 { font-family: var(--font-human); font-weight: 700; font-size: 2.2em; margin: 0.5em 0 0.2em; letter-spacing: -0.01em; }
  .sub { color: var(--text-2); font-family: var(--font-human); font-size: 1.1em; margin: 0 0 2em; }
  .card { background: var(--navy-2); border: 1px solid var(--navy-line); border-radius: 8px; padding: 24px; max-width: 720px; }
  .kv { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin: 0; }
  .kv dt { color: var(--text-muted); }
  .kv dd { margin: 0; }
  a { color: var(--orange); }
  :focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
</style>
