---
// Paper mode: the customer-facing custody page. Paper is the physical object;
// the chain shows through in the chain font. Tokens come from design/tokens.json.
import tokens from '../../../design/tokens.json';

interface Props {
  title: string;
  right?: string;
  brand?: string;
  wide?: boolean;
}
const { title, right = '', brand = 'VAULT CUSTODY', wide = false } = Astro.props;
const c = tokens.modes.paper.color;
const f = tokens.modes.paper.font;
const vars = [
  `--paper:${c.paper.value}`,
  `--surface:${c['paper-surface'].value}`,
  `--line:${c['paper-line'].value}`,
  `--ink:${c.ink.value}`,
  `--muted:${c['ink-muted'].value}`,
  `--sealed:${c.sealed.value}`,
  `--opened:${c.opened.value}`,
  `--custody:${c.custody.value}`,
  `--pack:${c.pack.value}`,
  `--photo:${c.photo.value}`,
  `--font-human:${f.human.family}`,
  `--font-chain:${f.chain.family}`
].join(';');
---

<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex" />
    <title>{title} · Vault Custody</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[{ wide }]}>
    <header class="top">
      <span class="brand">{brand}</span>
      <span class="right">{right}</span>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <slot name="foot" />
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { background: var(--paper); }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font-family: var(--font-human); font-size: clamp(16px, 2.6vw, 20px); line-height: 1.35;
    -webkit-font-smoothing: antialiased;
  }
  body.wide { font-size: 16px; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; max-width: 780px; margin: 0 auto; padding: 40px 40px 20px; }
  body.wide .top { max-width: none; padding: 40px 48px 8px; }
  .brand { font-weight: 700; letter-spacing: 0.01em; }
  .right { color: var(--muted); font-size: 0.9em; text-align: right; }
  main { max-width: 780px; margin: 0 auto; padding: 0 40px 40px; }
  body.wide main { max-width: none; padding: 0 48px 48px; }
  .foot { max-width: 780px; margin: 0 auto; padding: 0 40px 48px; color: var(--muted); font-size: 0.8em; line-height: 1.4; }
  body.wide .foot { max-width: none; padding: 0 48px 48px; }

  .badge { display: inline-block; border-radius: 999px; padding: 0.45em 1.3em; color: #fff; font-weight: 700; letter-spacing: 0.02em; background: var(--custody); font-size: 1em; }
  .badge.opened { background: var(--opened); }
  .badge.sealed { background: var(--sealed); }
  h1 { font-size: 2.4em; line-height: 1.05; font-weight: 700; margin: 0.6em 0 0.25em; letter-spacing: -0.01em; text-wrap: balance; }
  body.wide h1 { font-size: 2.2em; margin: 0.4em 0 0.8em; }
  .sub { color: var(--muted); font-size: 1.2em; margin: 0 0 1.4em; line-height: 1.3; }
  h2 { font-size: 1.1em; font-weight: 700; margin: 0 0 0.9em; }

  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 1.6em 1.7em; margin-bottom: 1.2em; }
  .kv { display: grid; grid-template-columns: minmax(7em, 0.36fr) 1fr; row-gap: 0.95em; column-gap: 1.2em; margin: 0; }
  .kv dt { color: var(--muted); }
  .kv dd { margin: 0; }

  .tl { list-style: none; margin: 0; padding: 0; }
  .tl li { position: relative; padding-left: 2.4em; padding-bottom: 1.3em; }
  .tl li::before { content: ''; position: absolute; left: 0.35em; top: 0.35em; width: 0.9em; height: 0.9em; border-radius: 50%; background: var(--sealed); }
  .tl li.opened::before { background: var(--opened); }
  .tl li.pack::before { background: var(--pack); }
  .tl li::after { content: ''; position: absolute; left: 0.75em; top: 1.4em; bottom: -0.2em; width: 2px; background: var(--line); }
  .tl li:last-child::after { display: none; }
  .tl .m { color: var(--muted); font-size: 0.8em; margin-top: 0.15em; }

  .btn { display: block; width: 100%; background: var(--custody); color: #fff; font: inherit; font-weight: 700; font-size: 1.15em; text-align: center; padding: 1em; border-radius: 12px; text-decoration: none; border: 0; cursor: pointer; }
  .btn[disabled] { opacity: 0.55; cursor: default; }
  .chain { font-family: var(--font-chain); font-size: 0.85em; }
  a { color: var(--custody); }

  .tapbanner { display: none; border: 2px solid var(--sealed); background: var(--surface); border-radius: 16px; padding: 0.9em 1.2em; margin: 0 0 1.2em; }
  .tapbanner.show { display: block; }
  .tapbanner.broken { border-color: var(--opened); }
  .tapbanner b { display: block; }
  .tapbanner .m { color: var(--muted); font-size: 0.85em; }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.75em 0.5em; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 700; }
  tr:last-child td { border-bottom: 0; }
  td.flag { color: var(--opened); font-weight: 700; }
  .num { font-variant-numeric: tabular-nums; }
  :focus-visible { outline: 2px solid var(--custody); outline-offset: 2px; }
</style>
