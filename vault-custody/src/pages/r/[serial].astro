---
// The receipt page: sealed or opened, from the unit's chain. The /t tap route
// lands here with ?tap=<receipt>&n=<counter>&tt=<status>; the banner reads it.
import Paper from '../../layouts/Paper.astro';
import { EPOCH, fmtDate, units } from '../../lib/registry';

export function getStaticPaths() {
  return Object.keys(units).map((serial) => ({ params: { serial } }));
}

const { serial } = Astro.params;
const u = units[serial!];
if (!u) return new Response(null, { status: 404 });
const opened = u.state === 'opened';
const sealedAt = fmtDate(u.sealed.at);
const openedAt = u.opened ? fmtDate(u.opened.at) : '';
---

<Paper title={`Box ${u.serial}`} right={`receipt · epoch ${EPOCH}`}>
  <div id="tap" class="tapbanner" role="status" aria-live="polite">
    <b id="tap-title">Tap verified</b>
    <span id="tap-meta" class="m"></span>
  </div>

  <span class:list={['badge', opened ? 'opened' : 'sealed']}>{opened ? 'OPENED' : 'SEALED'}</span>
  <h1>Box {u.serial}</h1>
  {
    opened && u.opened ? (
      <p class="sub">
        Opened {openedAt} PT · {u.opened.city} · by {u.opened.byClaimedOwner ? 'the claimed owner' : 'an unclaimed tap'}
      </p>
    ) : (
      <p class="sub">
        Sealed {sealedAt} PT · {u.sealed.where}{u.event ? ` · event 1/1 · ${u.event}` : ''}
      </p>
    )
  }

  <section class="panel">
    <dl class="kv">
      {
        opened && u.opened ? (
          <>
            <dt>Seal</dt><dd>{u.opened.sealLoop}</dd>
            <dt>Reveal tag</dt><dd>{u.opened.revealTag}</dd>
            <dt>Owner</dt><dd>claimed {u.claimed ? `${fmtDate(u.claimed.at).replace(/, \d{4}/, '')} · ${u.claimed.ownerInitials}` : '—'}</dd>
            <dt>Packs</dt><dd>{u.packs ? `${u.packs.opened} of ${u.packs.total} opened · ${u.packs.first} → ${u.packs.last}` : '—'}</dd>
            <dt>Cards attached</dt><dd>{u.cards ? `${u.cards.attached} scanned · ${u.cards.hits} hits · ${u.cards.numbered} numbered` : '—'}</dd>
          </>
        ) : (
          <>
            <dt>Product</dt><dd>{u.product} · Series {u.series}</dd>
            <dt>Sealed</dt><dd>{u.sealed.where} · {sealedAt} · by {u.sealed.by}</dd>
            <dt>Seal report</dt><dd>signature {u.seal?.signature ?? 'valid'} · loop {u.seal?.loop ?? 'intact'} · tap count {u.seal?.taps ?? 1}</dd>
            <dt>Contents</dt><dd>hash <span class="chain">{u.contentsHash}</span> committed and published to Series {u.series} before sale</dd>
            <dt>Photos</dt><dd>{u.sealed.photos} of the factory shrink, hashed into the receipt</dd>
          </>
        )
      }
    </dl>
  </section>

  <section class="panel">
    <h2>Custody timeline</h2>
    <ul class="tl">
      {u.timeline.map((t) => (
        <li class={t.kind}>
          <div>{t.title}</div>
          <div class="m">{t.meta}</div>
        </li>
      ))}
    </ul>
  </section>

  {!opened && <button class="btn" type="button" disabled>Claim it · ships with the pilot</button>}
  <a class="btn companion" href={`/companion/?serial=${u.serial}`}>Open in the Custody Companion</a>

  <p slot="foot">Locations are city-level and owner-shared. Identities are hashed; only the owner sees their own name.</p>

  <style>
    .companion { margin-top: 1em; background: var(--surface); color: var(--custody); border: 1px solid var(--custody); }
  </style>

  <script>
    const q = new URLSearchParams(location.search);
    const tap = q.get('tap');
    if (tap) {
      const el = document.getElementById('tap')!;
      const title = document.getElementById('tap-title')!;
      const meta = document.getElementById('tap-meta')!;
      const n = q.get('n');
      const tt = q.get('tt');
      const broken = tt ? tt[0] === 'O' : false;
      title.textContent = broken ? 'Tap verified · seal loop broken' : 'Tap verified · signature valid';
      meta.textContent = `counter ${n ?? '?'} · receipt ${tap} · ${tt ? `tamper ${tt}` : 'tamper not reported'} · ${new Date().toLocaleTimeString()}`;
      if (broken) el.classList.add('broken');
      el.classList.add('show');
    }
  </script>
</Paper>
