---
import Paper from '../layouts/Paper.astro';
import { manufacturer as m } from '../lib/registry';
---

<Paper title="Manufacturer view" brand="VAULT CUSTODY · MANUFACTURER VIEW" right={m.release} wide>
  <h1>{m.headline}</h1>

  <section class="tiles">
    {m.tiles.map((t) => (
      <div class="tile">
        <div class="v num">{t.value}</div>
        <div class="l">{t.label}</div>
      </div>
    ))}
  </section>

  <section class="cols">
    <div class="panel">
      <h2>By retailer</h2>
      <table>
        <thead><tr><th>Retailer</th><th>Sealed</th><th>Opened</th><th>Tamper</th><th>Avg days to open</th><th>Hits reported</th></tr></thead>
        <tbody>
          {m.retailers.map((r) => (
            <tr>
              <td>{r.name}</td>
              <td class="num">{r.sealed}</td>
              <td class="num">{r.opened}</td>
              <td class:list={['num', { flag: r.flag }]}>{r.tamper}</td>
              <td class="num">{r.days}</td>
              <td class:list={[{ flag: r.flag }]}>{r.hits}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">{m.retailerNote}</p>
    </div>

    <div class="panel">
      <h2>Hit distribution vs. printed odds</h2>
      <ul class="odds">
        {m.odds.map((o) => (
          <li>
            <div>{o.label}</div>
            <div class="bar"><span class:list={[{ flag: o.flag }]} style={`width:${o.pct}%`}></span></div>
          </li>
        ))}
      </ul>
      <p class="note">{m.oddsNote}</p>
      <h2>Secondary market</h2>
      <table>
        <thead><tr><th>Metric</th><th>Custody-verified</th><th>Unverified</th></tr></thead>
        <tbody>
          {m.secondary.map((s) => (
            <tr><td>{s.metric}</td><td class="num">{s.verified}</td><td class="num">{s.unverified}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="note">Illustrative figures for the pilot design — every number here is one the pilot would measure.</p>
    </div>
  </section>
</Paper>

<style>
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 24px; }
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px 24px 28px; }
  .tile .v { font-size: 2.4em; font-weight: 700; line-height: 1.1; }
  .tile .l { color: var(--muted); margin-top: 6px; }
  .cols { display: grid; grid-template-columns: 1.45fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 1100px) { .cols { grid-template-columns: 1fr; } }
  .note { color: var(--muted); font-size: 0.9em; margin: 1em 0 0; }
  .odds { list-style: none; margin: 0 0 0.5em; padding: 0; }
  .odds li { margin-bottom: 1em; }
  .bar { height: 12px; border-radius: 6px; background: var(--line); margin-top: 6px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--custody); border-radius: 6px; }
  .bar span.flag { background: var(--opened); }
  h2 { margin-top: 0.4em; }
  h2 + table { margin-top: 0.2em; }
  .panel h2:not(:first-child) { margin-top: 1.4em; }
</style>
