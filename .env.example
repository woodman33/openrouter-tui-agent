OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-opus-4.7

# OpenAI API (optional direct provider registry)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.2

# GitBook documentation publishing
GITBOOK_API_KEY=
GITBOOK_ENDPOINT=https://api.gitbook.com

# Daytona (Persistent Dev Sandboxes)
DAYTONA_API_KEY=your-daytona-api-key-here
DAYTONA_SERVER_URL=https://api.daytona.io
DAYTONA_TARGET_PROVIDER=docker

# Trigger.dev (Asynchronous Background Runners)
TRIGGER_SECRET_KEY=your-trigger-secret-key-here
TRIGGER_API_URL=https://api.trigger.dev

# Cloudflare AI Gateway
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_NAME=openrouter-tui-gateway

# Composio Swarm Tools (Apple Kits, StoreKit, LiveKit, etc.)
COMPOSIO_API_KEY=your-composio-api-key-here
COMPOSIO_ORGANIZATION_ACCESS_TOKEN_SECRET=your-composio-organization-token-here

# Clerk Authentication (Launch-grade trust layer)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
