# ==============================================================================
# FOUNDER TERMINAL / AGENTOPS TUI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM & Model Settings
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3-5-sonnet
LLM_BASE_URL=

# OpenRouter Settings (Existing Workspace Routing fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenHands Cloud integrations
OPENHANDS_CLOUD_API_KEY=
OPENHANDS_CLOUD_API_URL=https://app.all-hands.dev

# Core Operations & Webhooks
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# File System Directories
FOUNDER_TERMINAL_HOME=~/.founder-terminal
FOUNDER_TERMINAL_RUNS_DIR=~/.founder-terminal/runs
FOUNDER_TERMINAL_RECIPES_DIR=./recipes

# Runtime Safety & Sandbox Guards
DEFAULT_SANDBOX=process     # process | docker
DEFAULT_RUNTIME=local_sdk   # local_sdk | local_server
ENABLE_DANGEROUS_COMMANDS=false
ALLOW_FORCE_PUSH=false
ALLOW_WRITE_ACTIONS=false
