{
  "$schema": "https://timmy.dev/schemas/design-tokens-v1.json",
  "name": "timmy-vault-custody",
  "version": "2026-09-05",
  "note": "Two deliberate modes. `product` is every dark/verify surface and the companion: navy ground, phosphor for the chain, orange for the human. `paper` is the customer-facing custody page: paper is the physical object, navy/phosphor is the chain. The former cyan/green/amber + Outfit/Inter/Fira Code system is deprecated. Qwen seals design.lock from this file during the TUI overhaul.",
  "grid": { "unit": 8, "unitPx": 8 },
  "scale": {
    "ratio": 1.333,
    "basePx": 16,
    "steps": {
      "-2": 9,
      "-1": 12,
      "0": 16,
      "1": 21.33,
      "2": 28.43,
      "3": 37.9,
      "4": 50.52,
      "5": 67.34
    }
  },
  "modes": {
    "product": {
      "color": {
        "navy": { "value": "#0A1628", "role": "ground · every dark/verify surface" },
        "navy-2": { "value": "#101F38", "role": "raised surface on navy (derived, +1 step)" },
        "navy-line": { "value": "#1B2E4D", "role": "hairline on navy (derived)" },
        "phosphor": { "value": "#33FF66", "role": "chain · hashes, sealed, verified, receipts. Never for buttons." },
        "phosphor-dim": { "value": "#1F9E44", "role": "chain, secondary (derived)" },
        "orange": { "value": "#FF8C1A", "role": "human · actions, owners, taps, buttons, anything a person did or can do" },
        "red": { "value": "#FF3B3B", "role": "refusal ONLY · denied, refused, launch refused. Not for tamper (tamper is a human-world event → orange)." },
        "text": { "value": "#E6EDF7", "role": "human text on navy (derived)" },
        "text-2": { "value": "#9FB0C8", "role": "secondary human text (derived)" },
        "text-muted": { "value": "#5A6C87", "role": "chrome, timestamps (derived)" }
      },
      "font": {
        "human": { "family": "\"Space Grotesk\", \"Helvetica Neue\", Arial, sans-serif", "role": "human text" },
        "chain": { "family": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, monospace", "role": "chain text · hashes, receipts, ids, counters" },
        "googleFonts": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      },
      "radius": { "none": 0, "control": 4, "panel": 8 },
      "semantic": {
        "chain": "phosphor",
        "human": "orange",
        "refusal": "red",
        "ground": "navy",
        "tamper": "orange"
      }
    },
    "paper": {
      "note": "Customer-facing custody pages (receipt, card, relic, series). Warm paper = the physical object. Chain text on paper still uses the chain font; phosphor is replaced by paper-green because phosphor fails contrast on paper.",
      "color": {
        "paper": { "value": "#F4F2EC", "role": "page ground" },
        "paper-surface": { "value": "#FFFFFF", "role": "card surface" },
        "paper-line": { "value": "#D9D4C8", "role": "card border, dividers, timeline rail" },
        "ink": { "value": "#1B1A17", "role": "headline and body text" },
        "ink-muted": { "value": "#6D6A62", "role": "labels, timestamps, footnotes" },
        "sealed": { "value": "#2E6B3E", "role": "sealed / signed / verified events (timeline dots, checks)" },
        "opened": { "value": "#8E2A2A", "role": "opened / tamper / below-odds (badge, timeline dot, table emphasis)" },
        "custody": { "value": "#6F4726", "role": "custody-verified badge, primary button, chart fill" },
        "pack": { "value": "#B69457", "role": "pack-level events (timeline dot)" },
        "photo": { "value": "#CFC7B8", "role": "photo placeholder tint" }
      },
      "font": {
        "human": { "family": "\"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif", "role": "human text on paper (matches the pitch mocks)" },
        "chain": { "family": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, monospace", "role": "serials, hashes, counters" }
      },
      "radius": { "badge": 999, "card": 16, "button": 12 },
      "semantic": {
        "chain": "sealed",
        "human": "custody",
        "tamper": "opened",
        "ground": "paper"
      }
    }
  },
  "usage": {
    "productSurfaces": ["companion", "timmy log page", "verify page (/t result)", "any dark surface"],
    "paperSurfaces": ["receipt page (sealed/opened)", "card page", "relic page", "series page", "manufacturer view"]
  }
}
