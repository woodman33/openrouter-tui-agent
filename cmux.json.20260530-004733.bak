{
  "version": 1,
  "custom_commands": [
    {
      "id": "timmy-tui-start",
      "shortcut": "cmd+shift+t",
      "command": "npm start",
      "label": "Start TIMMY TUI OS",
      "cwd": "workspace"
    },
    {
      "id": "timmy-tui-build",
      "shortcut": "cmd+shift+b",
      "command": "npm run build",
      "label": "Build TIMMY TypeScript",
      "cwd": "workspace"
    },
    {
      "id": "timmy-tui-doctor",
      "shortcut": "cmd+shift+d",
      "command": "npx tsx scripts/timmy-doctor.ts doctor",
      "label": "Run TIMMY Diagnosis",
      "cwd": "workspace"
    },
    {
      "id": "timmy-tui-security",
      "shortcut": "cmd+shift+s",
      "command": "scripts/security-scan.sh",
      "label": "Run Security Secret Scan",
      "cwd": "workspace"
    }
  ]
}
