{"kind":"shape","slide":10,"role":"card body","bbox":[388,322,216,160]}
{"kind":"textbox","slide":10,"role":"card body","text":"Keep keys server-side. Minimize user data. Set exact CSP domains for widgets. Do not expose secrets in structuredContent, content, or _meta.","bbox":[388,322,216,160]}
