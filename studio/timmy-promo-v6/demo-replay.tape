Output demo-replay.mp4
Set Width 1280
Set Height 720
Set FontSize 24
Set LineHeight 1.5
Set Theme { "name": "timmy", "black": "#05060a", "red": "#ff6b6b", "green": "#3fb950", "yellow": "#f5b540", "blue": "#79c0ff", "magenta": "#a98bff", "cyan": "#79c0ff", "white": "#e6edf3", "background": "#05060a", "foreground": "#e6edf3", "selection": "#2d333b" }
Set TypingSpeed 25ms
Set Shell "bash"
Sleep 400ms
Type "export PS1='timmy $ '"
Enter
Sleep 200ms
Type "bash replay-demo.sh"
Enter
Sleep 3400ms
